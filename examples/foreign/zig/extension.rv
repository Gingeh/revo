##
  build first:
  zig build && cp zig-out/lib/libzrevo.* ./zrevo.so
  then: revo ./extension.rv
##

import 'zrevo.so'

# the sibling zrevo.d.rv is the interface: every call is typed against it,
# and all bindings land in this module's table
print("zadd:", zrevo.zadd(3, 4))
print("zecho:", zrevo.zecho("hello"))
print("zconcat:", zrevo.zconcat(("a", "b", "c"), "/"))
