# interface manifest for zrevo.so
#
# import 'zrevo.so' picks this file up (same stem) and types all calls
# against it - sigs in the .so itself are ignored while this exists
#
pub declare zadd = fn(a: number, b: number) -> number
pub declare zecho = fn(s: string) -> string
pub declare zsetglobal = fn(name: string, value) -> number
pub declare zconcat = fn(parts: tuple, sep: string) -> string
