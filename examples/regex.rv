# compile a pattern (get a table back)
let pat = re.compile("l+")
print("pat: {pat:p}")

# is_match
print("is_match(table):", re.is_match(pat, "hello world"))
print("is_match(str):", re.is_match("l+", "hello world"))

# find
print("find(table):", re.find(pat, "hello world"))
print("find(str):", re.find("l+", "hello world"))

# find_all
for m in re.find_all(pat, "hello world") do
  print("match: {m.match:p} at {m.start:p} - {m.end:p}")
end
for m in re.find_all("[aeiou]", "hello world") do
  print("vowel: {m.match:p}")
end

# no match returns nil
print("no match:", re.find(pat, "xyz"))
print("no match(str):", re.find("x+", "hello"))

# use free to manually release the handle
re.free(pat)
