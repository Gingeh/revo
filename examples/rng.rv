# `rng.rand` returns a random integer in the range [0, upper_bound]
print("rng.rand(10) = #{rng.rand(10)}")

# `rng.range` returns a random integer in the range [lower_bound, upper_bound]
print("rng.range(4, 12) = #{rng.range(4, 12)}")

# `rng.choice` returns a random element from the given table
print("rng.choice(#{rng.choice({1, 2, 3, hi, :false})}) = #{rng.choice({1, 2, 3, 'hi', :false})}")

print("\n --- Post `set_seed(2226)` -----")
rng.set_seed(2226) # allows for statically assigning the seed to be used for random number generation

for _ in 0..3 
    print(rng.rand(10)) # this will always come out to `10`

rng.revert_seed() # Reverts the current seed back to being automatically set to the current time per generation

print("\n --- Post `revert_seed()` -----")
for _ in 0..3 
    print(rng.rand(10)) # the results should differ now
